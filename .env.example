# Node 24 LTS is required. Copy to .env; never include .env in a release ZIP.
APP_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/voltmart.sqlite
TRUST_PROXY=0

# Bootstrap administrator: set temporarily, run npm run admin:create, then remove.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Stripe payments, recurring savings and Identity. Use test credentials first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio Verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Shippo. Address is a JSON object with name,street1,city,state,zip,country,phone,email.
SHIPPO_TOKEN=
SHIP_FROM_ADDRESS=

# SMTP account recovery email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

BACKUP_DIRECTORY=data/backups
